{
  "name": "cipherdrop",
  "version": "2.0.0",
  "description": "Next-Generation Zero-Knowledge Sovereign Secret Exchange Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "test": "tsx --test tests/crypto.test.js && tsx --test tests/e2e_integration.test.js && tsx --test tests/time_lock.test.js",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --include=server/**/*.js --include=src/crypto/**/*.ts npm test",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.10.0",
    "c8": "^12.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.475.0",
    "ogl": "^1.0.11",
    "postcss": "^8.5.2",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.19.0",
    "shamir-secret-sharing": "^0.0.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "ws": "^8.18.0"
  }
}
